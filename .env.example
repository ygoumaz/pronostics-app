# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/pronostics_cdm_2026?schema=public"

# NextAuth.js (Auth.js v5)
# AUTH_SECRET est le nom lu par défaut par NextAuth v5 ; NEXTAUTH_SECRET reste
# accepté pour compatibilité (cf. src/auth.config.ts). Générer un secret fort
# en production, p.ex. avec : openssl rand -base64 32
AUTH_SECRET="votre-secret-ici"
NEXTAUTH_SECRET="votre-secret-ici"
NEXTAUTH_URL="http://localhost:3000"

# Participant administrateur initial (utilisé par prisma/seed.ts)
# Valeurs par défaut si non définies : admin@pronostics.local / changeme-admin-2026
# IMPORTANT : définir un mot de passe fort en production.
ADMIN_EMAIL="admin@pronostics.local"
ADMIN_DISPLAY_NAME="Administrateur"
ADMIN_PASSWORD="changeme-admin-2026"
